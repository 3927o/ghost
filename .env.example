# Server configuration
HOST=0.0.0.0
PORT=3000

# Business database for API and Worker. Each process owns its own pool.
# Start the local PostgreSQL instance with docker compose up -d postgres redis.
DATABASE_TYPE=postgres
DATABASE_URL=postgres://ghost:ghost@127.0.0.1:5432/ghost
DATABASE_POOL_SIZE=10
# Alternatives: DATABASE_TYPE=mysql with a mysql:// URL;
# or DATABASE_TYPE=sqlite with DATABASE_PATH=./data/ghost-orm.sqlite.
# Old ghost.sqlite files are not automatically migrated.

# Agent plugins share a separate client/pool, owned by the Cordis Provider.
# These settings inherit DATABASE_* when omitted. Override to use another backend.
# AGENT_DATABASE_TYPE=postgres
# AGENT_DATABASE_URL=postgres://ghost:ghost@127.0.0.1:5432/ghost
# AGENT_DATABASE_POOL_SIZE=10
# AGENT_DATABASE_PATH=./data/agent-orm.sqlite

# Redis/BullMQ task transport. Start the local instance with docker compose up -d redis.
REDIS_URL=redis://127.0.0.1:6379
REDIS_QUEUE_NAME=ghost-agent-runs
WORKER_LOCK_MS=30000
WORKER_CONCURRENCY=3

# Worker only: initial provider and model. API can start without these settings.
MODEL_PROVIDER=gateway
MODEL_NAME=model-a

# Add interfaces and models here. api accepts:
# openai-completions | openai-responses | anthropic-messages
MODEL_PROVIDERS='{
  "gateway": {
    "api": "openai-completions",
    "baseURL": "https://gateway.example.com/v1",
    "apiKeyEnv": "GATEWAY_API_KEY",
    "models": [
      { "id": "model-a", "maxTokens": 4096 },
      { "id": "model-b", "maxTokens": 8192 }
    ]
  },
  "claude": {
    "api": "anthropic-messages",
    "baseURL": "https://api.anthropic.com",
    "apiKeyEnv": "CLAUDE_API_KEY",
    "models": [
      { "id": "your-claude-model-id", "maxTokens": 4096 }
    ]
  }
}'

GATEWAY_API_KEY=
CLAUDE_API_KEY=
