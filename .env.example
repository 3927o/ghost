# Server configuration
HOST=0.0.0.0
PORT=3000

# SQLite session database. Relative paths resolve from the working directory.
SESSION_DB_PATH=./data/ghost.sqlite

# Initial selection: provider key and an id from its models list.
MODEL_PROVIDER=gateway
MODEL_NAME=model-a

# Add interfaces and models here. api accepts:
# openai-completions | openai-responses | anthropic-messages
MODEL_PROVIDERS='{
  "gateway": {
    "api": "openai-completions",
    "baseURL": "https://gateway.example.com/v1",
    "apiKeyEnv": "GATEWAY_API_KEY",
    "models": [
      { "id": "model-a", "maxTokens": 4096 },
      { "id": "model-b", "maxTokens": 8192 }
    ]
  },
  "claude": {
    "api": "anthropic-messages",
    "baseURL": "https://api.anthropic.com",
    "apiKeyEnv": "CLAUDE_API_KEY",
    "models": [
      { "id": "your-claude-model-id", "maxTokens": 4096 }
    ]
  }
}'

GATEWAY_API_KEY=
CLAUDE_API_KEY=
