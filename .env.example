# Server configuration
HOST=0.0.0.0
PORT=3000

# Shared local SQLite file for API and Worker.
DATABASE_PATH=./data/ghost.sqlite

# Redis/BullMQ task transport. Start the local instance with docker compose up -d redis.
REDIS_URL=redis://127.0.0.1:6379
REDIS_QUEUE_NAME=ghost-agent-runs
WORKER_LOCK_MS=30000

# Worker only: initial provider and model. API can start without these settings.
MODEL_PROVIDER=gateway
MODEL_NAME=model-a

# Add interfaces and models here. api accepts:
# openai-completions | openai-responses | anthropic-messages
MODEL_PROVIDERS='{
  "gateway": {
    "api": "openai-completions",
    "baseURL": "https://gateway.example.com/v1",
    "apiKeyEnv": "GATEWAY_API_KEY",
    "models": [
      { "id": "model-a", "maxTokens": 4096 },
      { "id": "model-b", "maxTokens": 8192 }
    ]
  },
  "claude": {
    "api": "anthropic-messages",
    "baseURL": "https://api.anthropic.com",
    "apiKeyEnv": "CLAUDE_API_KEY",
    "models": [
      { "id": "your-claude-model-id", "maxTokens": 4096 }
    ]
  }
}'

GATEWAY_API_KEY=
CLAUDE_API_KEY=
