{
  "name": "Ghost",
  "version": "0.2",
  "theme": "light",
  "format": "CSS variable values keyed without --ghost- prefix; aliases preserve var() references",
  "tokens": {
    "font-sans": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei\", sans-serif",
    "font-mono": "\"SFMono-Regular\", Consolas, \"Liberation Mono\", monospace",
    "font-brand": "Arial, sans-serif",
    "bg-canvas": "#FAFAFA",
    "bg-surface": "#FFFFFF",
    "bg-subtle": "#F3F3F3",
    "text-primary": "#242424",
    "text-secondary": "#595959",
    "text-muted": "#6E6E6E",
    "text-disabled": "#A6A6A6",
    "text-inverse": "#FFFFFF",
    "border-subtle": "#E7E7E7",
    "border-control": "#8A8A8A",
    "action-default": "#242424",
    "action-hover": "#3D3D3D",
    "action-pressed": "#111111",
    "state-hover": "#F0F0F0",
    "state-pressed": "#E8E8E8",
    "focus-ring": "#242424",
    "overlay": "rgb(0 0 0 / 24%)",
    "type-page-size": "22px",
    "type-page-line": "32px",
    "type-title-size": "14px",
    "type-title-line": "24px",
    "type-body-size": "14px",
    "type-body-line": "28px",
    "type-detail-size": "13px",
    "type-detail-line": "26px",
    "type-label-size": "11px",
    "type-label-line": "18px",
    "type-control-size": "12px",
    "type-control-line": "20px",
    "type-metric-size": "20px",
    "type-metric-line": "28px",
    "weight-regular": "400",
    "weight-medium": "500",
    "brand-size": "23px",
    "brand-line": "32px",
    "brand-weight": "700",
    "brand-tracking": "-.8px",
    "space-1": "4px",
    "space-2": "8px",
    "space-3": "12px",
    "space-4": "16px",
    "space-6": "24px",
    "space-8": "32px",
    "space-10": "40px",
    "content-gap": "var(--ghost-space-3)",
    "heading-gap": "var(--ghost-space-2)",
    "prose-gap": "var(--ghost-space-2)",
    "message-gap": "var(--ghost-space-10)",
    "message-inset": "var(--ghost-space-6)",
    "surface-inset": "var(--ghost-space-4)",
    "action-inset": "var(--ghost-space-2)",
    "radius-control": "8px",
    "radius-content": "12px",
    "radius-sheet": "20px",
    "control-height": "44px",
    "icon-small": "16px",
    "icon-default": "20px",
    "stroke": "1.5",
    "content-measure": "36rem",
    "duration-fast": "120ms",
    "duration-base": "180ms",
    "duration-listening": "700ms",
    "ease": "cubic-bezier(.2, .8, .2, 1)",
    "shadow-overlay": "0 16px 48px rgb(0 0 0 / 12%)"
  }
}
