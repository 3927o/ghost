{
  "name": "ghost",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node apps/api/main.ts",
    "start:api": "node apps/api/main.ts",
    "start:worker": "node apps/agent-worker/main.ts",
    "dev": "concurrently --kill-others --names api,web,worker \"npm run dev:api\" \"npm run dev:web\" \"npm run dev:worker\"",
    "dev:api": "node --watch apps/api/main.ts",
    "dev:worker": "node --watch --watch-path=apps/agent-worker --watch-path=packages --watch-path=.env apps/agent-worker/main.ts",
    "dev:web": "vite",
    "build:web": "vite build",
    "deploy": "node scripts/deploy.ts",
    "test:deploy": "node --test tests/deploy.test.ts",
    "preview": "vite preview",
    "check": "tsc -p tsconfig.json && tsc -p apps/web/tsconfig.json",
    "test": "node --test tests/*.test.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.3"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
